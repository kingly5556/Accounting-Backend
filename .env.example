# Must match the root ERPHUB app's JWT_SECRET exactly — this module only verifies
# tokens issued by ERPHUB, it never signs its own.
JWT_SECRET=replace-with-a-long-random-secret

# Shared secret for the Stock module's outbox worker -> POST /api/postings
# (service-to-service; never log it, never commit it)
ACCOUNTING_SERVICE_KEY=replace-with-another-long-random-secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/k_erp_accounting?schema=public

PORT=4002

# Optional: where the built SPA lives (default: ../Accounting-Frontend/dist)
# FRONTEND_DIST=../Accounting-Frontend/dist
